+/// 前缀缓存用的块哈希：按块链式累积（hash_i 依赖 hash_{i-1} 与本块 token），
+/// 保证“同一前缀在不同请求里得到同一串哈希”，且不同上下文不会撞成同一前缀。
+/// 只对填满的块计算，尾块（不足 block_size）不参与匹配。
+inline std::vector<uint64_t> compute_block_hashes(const std::vector<int> &token_ids, int block_size) {
+    constexpr uint64_t kSeed = 1469598103934665603ULL;
+    constexpr uint64_t kPrime = 1099511628211ULL;
+    TORCH_CHECK(block_size > 0, "block_size must be positive");
+    const int num_full = static_cast<int>(token_ids.size()) / block_size;
+    std::vector<uint64_t> hashes(static_cast<size_t>(num_full));
+    uint64_t prev = kSeed;
+    for (int b = 0; b < num_full; ++b) {
+        uint64_t h = prev;
+        const int *p = token_ids.data() + static_cast<size_t>(b) * block_size;
+        for (int i = 0; i < block_size; ++i) {
+            h ^= static_cast<uint64_t>(static_cast<uint32_t>(p[i]));
+            h *= kPrime;
+        }
+        hashes[static_cast<size_t>(b)] = h;
+        prev = h;
+    }
+    return hashes;
+}
