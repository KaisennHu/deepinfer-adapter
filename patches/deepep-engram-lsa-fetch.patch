+// Fetch path that needs no RDMA: it reads the intra-node storage segments that
+// `HybridElasticSymmetricMemory` mapped into this process. See
+// `engram_fetch_lsa.cuh` for the constraints (single RDMA peer).
+static void launch_engram_fetch_lsa(const deep_jit::NoRefPtr& nccl_dev_comm, const ncclWindow_t& nccl_window,
+                                    const void* storage_base, const int64_t& num_rdma_storage_bytes,
+                                    void* fetched, int* indices,
+                                    void* sf_shards, void* fetched_sf,
+                                    const int& sf_token_stride, const int& sf_hidden_stride,
+                                    const int& sf_layer_stride,
+                                    const int& num_sf_shards,
+                                    const std::vector<int>& num_entries_per_layer,
+                                    const int& hidden, const int& elem_size, const int& num_sf_packs,
+                                    const int& num_entries_per_token,
+                                    const int& num_tokens, const int& num_max_tokens,
+                                    const int& num_ranks_per_rdma_peer,
+                                    const at::cuda::CUDAStream& stream) {
+    constexpr int kNumThreads = 512;
+    const auto num_sms = jit->device.get_num_sms();
+
+    std::string num_entries_per_layer_string;
+    num_entries_per_layer_string.reserve(num_entries_per_layer.size() * 12);
+    for (const auto num_entries : num_entries_per_layer) {
+        if (not num_entries_per_layer_string.empty())
+            num_entries_per_layer_string += ", ";
+        num_entries_per_layer_string += std::to_string(num_entries);
+    }
+    const auto func_name = std::format(
+        "engram_fetch_lsa_impl<{}, {}, deep_ep::layout::EngramLayout<{}, {}, {}, {}, {}>, {}, {}>",
+        kNumThreads, num_max_tokens,
+        num_ranks_per_rdma_peer, num_sf_shards,
+        hidden * elem_size, num_entries_per_token,
+        num_entries_per_layer_string,
+        num_sf_packs, num_ranks_per_rdma_peer);
+
+    // Compile
+    const auto kernel = jit->compile("engram_fetch_lsa", std::format(R"(
+#include <deep_ep/impls/engram/engram_fetch_lsa.cuh>
+
+static void __instantiate_kernel() {{
+    auto ptr = reinterpret_cast<void*>(&deep_ep::engram::{});
+}}
+)", func_name));
+
+    // Launch
+    jit->launch(
+        kernel, {
+            .stream = stream.stream(),
+            .grid_dim = dim3(num_sms, 1, 1),
+            .block_dim = dim3(kNumThreads, 1, 1),
+        },
+        nccl_dev_comm, nccl_window,
+        static_cast<const uint8_t*>(storage_base), num_rdma_storage_bytes,
+        fetched, indices,
+        static_cast<const sf_pack_t*>(sf_shards), static_cast<sf_pack_t*>(fetched_sf),
+        sf_token_stride, sf_hidden_stride, sf_layer_stride,
+        num_tokens
+    );
+}
