diff --git a/deep_ep/include/deep_ep/impls/engram/engram_fetch_lsa.cuh b/deep_ep/include/deep_ep/impls/engram/engram_fetch_lsa.cuh
new file mode 100644
index 0000000..25c8638
--- /dev/null
+++ b/deep_ep/include/deep_ep/impls/engram/engram_fetch_lsa.cuh
@@ -0,0 +1,126 @@
+#pragma once
+
+#include <cstdint>
+
+#include <nccl.h>
+#include <nccl_device.h>
+
+#include <deep_ep/common/compiled.cuh>
+#include <deep_ep/common/math.cuh>
+#include <deep_ep/layout/engram/workspace.cuh>
+
+
+namespace deep_ep::engram {
+
+// Fetch path for hosts where every Engram peer lives in the same NVLink domain.
+//
+// The RDMA path issues one GIN read per entry, which needs an IB device. Here we
+// instead walk the storage segments that `HybridElasticSymmetricMemory` already
+// mapped into this process and copy with plain loads: each intra-node rank's
+// segment sits at `storage_base + i * num_rdma_storage_bytes`, and the mapping is
+// granted device access, so the copy works for both CPU and GPU storage.
+//
+// The caller must guarantee `kNumRDMAPeers == 1`. Entries that would belong to a
+// cross-node peer are skipped rather than served from the wrong segment.
+template <int kNumThreads, int kNumMaxTokens,
+          typename engram_layout_t,
+          int kNumSFPacks, int kNumRanksPerRDMAPeer>
+__global__ void __launch_bounds__(kNumThreads, 1)
+engram_fetch_lsa_impl(
+    const ncclDevComm_t nccl_dev_comm,
+    const ncclWindow_t nccl_window,
+    const uint8_t* storage_base,
+    const int64_t num_rdma_storage_bytes,
+    void* fetched,
+    const int* indices,
+    const sf_pack_t* sf_shards,
+    sf_pack_t* fetched_sf,
+    const int sf_token_stride,
+    const int sf_hidden_stride,
+    const int sf_layer_stride,
+    const int num_tokens
+) {
+    constexpr int kNumLayers = engram_layout_t::kNumLayers;
+    constexpr int kNumEntriesPerToken = engram_layout_t::kNumEntriesPerToken;
+    constexpr int kNumHiddenBytes = engram_layout_t::kNumHiddenBytes;
+    constexpr int kVecBytes = 16;
+    EP_STATIC_ASSERT(kNumHiddenBytes % kVecBytes == 0, "Engram hidden bytes must be 16-byte aligned");
+
+    const auto tid = static_cast<int64_t>(blockIdx.x) * kNumThreads + threadIdx.x;
+    const auto num_threads = static_cast<int64_t>(gridDim.x) * kNumThreads;
+    const auto num_entries = static_cast<int64_t>(num_tokens) * kNumEntriesPerToken;
+
+    // Weight vectors: each entry is one contiguous run of `kNumHiddenBytes`.
+    #pragma unroll
+    for (int layer_idx = 0; layer_idx < kNumLayers; ++ layer_idx) {
+        const auto num_entries_per_rank = engram_layout_t::get_num_entries(layer_idx);
+        const auto* layer_indices = indices + static_cast<int64_t>(layer_idx) * num_entries;
+        for (int64_t entry_idx = tid; entry_idx < num_entries; entry_idx += num_threads) {
+            const auto global_idx = __ldg(layer_indices + entry_idx);
+            if (global_idx < 0)
+                continue;
+
+            const auto rank_in_node = global_idx / num_entries_per_rank;
+            if (rank_in_node >= kNumRanksPerRDMAPeer)
+                continue;
+
+            const auto local_entry_idx = global_idx % num_entries_per_rank;
+            const auto* src = storage_base +
+                static_cast<int64_t>(rank_in_node) * num_rdma_storage_bytes +
+                engram_layout_t::get_storage_byte_offset(layer_idx, local_entry_idx);
+            auto* dst = static_cast<uint8_t*>(fetched) +
+                engram_layout_t::get_recv_byte_offset(layer_idx, entry_idx, kNumMaxTokens);
+
+            const auto* src_vec = reinterpret_cast<const uint4*>(src);
+            auto* dst_vec = reinterpret_cast<uint4*>(dst);
+            for (int i = 0; i < kNumHiddenBytes / kVecBytes; ++ i)
+                dst_vec[i] = src_vec[i];
+        }
+    }
+
+    // Scale factors already live in one shared buffer, so only the NVLink address
+    // translation is needed -- no GIN context involved.
+    if constexpr (kNumSFPacks > 0) {
+        constexpr int kPacksPerVec = sizeof(uint64_t) / sizeof(sf_pack_t);
+        constexpr int kNumVecs = kNumSFPacks / kPacksPerVec;
+        EP_STATIC_ASSERT(kNumSFPacks % kPacksPerVec == 0, "Invalid number of SF packs");
+
+        const auto lsa_rank = ncclTeamLsa(nccl_dev_comm).rank;
+        const auto lsa_base = reinterpret_cast<uint64_t>(ncclGetLsaPointer(nccl_window, 0, lsa_rank));
+        const auto sf_offset = reinterpret_cast<uint64_t>(sf_shards) - lsa_base;
+
+        #pragma unroll
+        for (int layer_idx = 0; layer_idx < kNumLayers; ++ layer_idx) {
+            const auto* layer_indices = indices + static_cast<int64_t>(layer_idx) * num_entries;
+            for (int64_t entry_idx = tid; entry_idx < num_entries; entry_idx += num_threads) {
+                const auto global_idx = __ldg(layer_indices + entry_idx);
+                if (global_idx < 0)
+                    continue;
+
+                const auto shard_idx = engram_layout_t::get_sf_shard_idx(layer_idx, global_idx);
+                const auto* shard = static_cast<const sf_pack_t*>(
+                    ncclGetLsaPointer(nccl_window, sf_offset, shard_idx));
+                const auto* src = reinterpret_cast<const uint64_t*>(
+                    shard + engram_layout_t::get_sf_row_idx(layer_idx, global_idx) * kNumSFPacks);
+
+                uint64_t values[kNumVecs];
+                #pragma unroll
+                for (int i = 0; i < kNumVecs; ++ i)
+                    values[i] = __ldg(src + i);
+
+                auto* dst = fetched_sf + layer_idx * sf_layer_stride +
+                    (entry_idx / kNumEntriesPerToken) * sf_token_stride +
+                    (entry_idx % kNumEntriesPerToken) * kNumSFPacks * sf_hidden_stride;
+                #pragma unroll
+                for (int i = 0; i < kNumVecs; ++ i) {
+                    #pragma unroll
+                    for (int j = 0; j < kPacksPerVec; ++ j)
+                        dst[(i * kPacksPerVec + j) * sf_hidden_stride] =
+                            reinterpret_cast<const sf_pack_t*>(&values[i])[j];
+                }
+            }
+        }
+    }
+}
+
+}  // namespace deep_ep::engram
