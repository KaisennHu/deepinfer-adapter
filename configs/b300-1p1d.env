# Validated on one 8-GPU B300 host, DeepSeek-V4.1-Flash-1017, DP4/EP4 per role.
# Sourced by run_pd_http.sh after PD_ROLE is validated. This is a greedy profile.
export DP_SIZE=4 NEXTN=7 MAX_MODEL_LEN=262144 GPU_MEM_UTIL=0.8 MAX_NUM_SEQS=32
export MAX_NUM_BATCHED_TOKENS=32768 LOOKAHEAD_TOKENS=1
export PD_PREFILL_ENGINE=NORMAL PD_DECODE_ENGINE=NORMAL
export DEEPINFER_ACCELERATOR=nvidia EP_DISABLE_GIN=1 ENABLE_NUMA_SHIM=1
export DEEPINFER_BATCH_INVARIANT=0 DEEPINFER_ENABLE_MTP_VARLEN=0
export DEEPINFER_SAMPLER_FORCE_TOPK=1 DEEPINFER_PREFIX_CACHE=0
export DEEPINFER_PD_FREEZE_STARTUP_GC=1 DEEPINFER_CUDAGRAPH_BATCH_SIZE_INTERVAL=8
export DEEPINFER_OVERRIDE_NUM_EXTRA_EXPERTS=0 DEEPINFER_EXPERT_REARRANGEMENT_STEP_INTERVAL=0
export DEEPINFER_EXPERT_COUNT_WINDOW_SIZE=3 DEEPINFER_FORCE_LOAD_BALANCE=0
export DEEPINFER_PROFILE_HTTP_ENABLE=0
export PD_COLD_ROUND_ROBIN=1 PD_DECODE_RANK_POLICY=source PD_CUDA_IPC_POOL=1
: "${PD_CUDA_IPC_POOL_ID:?set one unique pool ID, shared by P and D for this run}"
export PD_CUDA_IPC_POOL_ID
if [[ "$PD_ROLE" == prefill ]]; then
  export PD_PREFIX_SNAPSHOT_BYTES=1073741824 PD_YOCO_PREFIX_SNAPSHOTS=1
  export DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE=compact DEEPINFER_YOCO_PREFILL_KEEP_TOKENS=140
  export DEEPINFER_PREFILL_STORE_EXTRA_STATE=1
  export DEEPINFER_PREFILL_ATTEMPT_INTERVAL=1 DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL=1
  export DEEPINFER_DISABLE_RUNTIME_TIMERS=0 DEEPINFER_FUSE_SINGLETON_METADATA=0
  export DEEPINFER_PARALLEL_GREEDY_MAX=0 DEEPINFER_FUSE_GREEDY_REDUCTION=0
else
  export PD_PREFIX_SNAPSHOT_BYTES=0 PD_YOCO_PREFIX_SNAPSHOTS=0
  export DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE=off DEEPINFER_YOCO_PREFILL_KEEP_TOKENS=0
  export DEEPINFER_PREFILL_STORE_EXTRA_STATE=0
  export DEEPINFER_DISABLE_RUNTIME_TIMERS=1 DEEPINFER_FUSE_SINGLETON_METADATA=1
  export DEEPINFER_PARALLEL_GREEDY_MAX=1 DEEPINFER_FUSE_GREEDY_REDUCTION=1
fi
